name: Supabase Keep Alive

on:
  schedule:
    - cron: '0 0 * * 0' # Roda todo domingo às 21:00 (Brasília)
  workflow_dispatch: # Mantém o botão para rodar manualmente

jobs:
  ping:
    runs-on: ubuntu-latest
    steps:
      - name: Ping Supabase API
        id: supabase_ping
        run: |
          # Executa o curl limpo que você já testou e validou.
          # Adicionamos uma verificação interna no bash para garantir que a rede completou a operação.
          curl -X GET "${{ secrets.SUPABASE_URL }}/rest/v1/" \
          -H "apikey: ${{ secrets.SUPABASE_ANON_KEY }}" \
          -H "Authorization: Bearer ${{ secrets.SUPABASE_ANON_KEY }}"
          
          # Se o comando curl falhar completamente por falta de conexão, o script avisa o GitHub
          if [ $? -ne 0 ]; then
            echo "Erro crítico de rede ao alcançar o Supabase."
            exit 1
          fi
          
